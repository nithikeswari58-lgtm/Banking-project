          <mxGeometry x="1140" y="465" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="atmMenu" value="ATM menu: view balance, deposit, withdraw. Transfer and history are blocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
