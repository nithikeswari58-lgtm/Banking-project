  <diagram id="transfer-flow" name="2. Transfer funds">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t0" value="Customer at the branch starts Transfer funds" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="30" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="Enter destination account and amount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="«include» View balance. Read the source account before any money moves." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="230" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="Enough balance, and both accounts open?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="450" y="340" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="Stop. Show not enough balance." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="365" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="Amount over $1,000?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="500" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="Move money now. Debit source, credit destination, write two transactions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="«extend» Hold the amount on the source account and mark the transfer pending." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="610" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="Manager approves?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="740" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="Credit the destination. Transfer is completed." style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="860" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="Return the held amount to the source. Transfer is rejected." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="860" y="900" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="Done. Balance and history update." style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="860" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a1" style="endArrow=block;html=1;" edge="1" parent="1" source="t0" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
